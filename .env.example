# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# "development" or "production"
MTAAFIX_ENV=development

# Database: SQLite file by default; a MySQL URL can be used later without code changes.
# DATABASE_URL=sqlite:////home/<username>/mtaafix/instance/mtaafix.db

# Photo storage (Cloudinary). Leave empty in development to store photos locally.
CLOUDINARY_URL=

# Email (Gmail SMTP with an app password). Leave MAIL_USERNAME empty to log emails instead of sending.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Map starting point (default: Nairobi CBD) and zoom level
MAP_CENTER_LAT=-1.286389
MAP_CENTER_LNG=36.817223
MAP_ZOOM=13

# Sessions: log out after this many idle minutes; "Keep me logged in" lasts this many days
SESSION_IDLE_MINUTES=30
REMEMBER_DAYS=14

# AI triage (Phase 4-5). Leave AI_ENABLED=false to run without AI; residents then pick the category.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
